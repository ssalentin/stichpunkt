# Directory holding the markdown files (the "space"). Mounted read-write.
SPACE_DIR=/space
# Bearer token for /mcp and /api. Generate: openssl rand -base64 32
MDWIKI_API_TOKEN=change-me
# Internal Kroki core container (PlantUML, Graphviz, D2, ...). Empty disables server-side diagrams.
KROKI_URL=http://kroki:8000
# Seconds-in-ms between mtime polls for changes made outside the app.
POLL_INTERVAL=10000
# Max bytes of a markdown write / of an attachment upload.
MAX_WRITE_BYTES=1048576
MAX_UPLOAD_BYTES=20971520
# adapter-node
PORT=3000
HOST=0.0.0.0
# Behind Traefik (TLS terminated there): trust the proxy scheme/host.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
# Uploads/saves above this size are refused by the Node server itself.
BODY_SIZE_LIMIT=25M
